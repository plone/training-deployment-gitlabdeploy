# syntax=docker/dockerfile:1
ARG PYTHON_VERSION=3.13
ARG PLONE_VERSION=6.2.1
FROM plone/server-builder:uv-${PYTHON_VERSION} AS builder

# Install project dependencies based on uv.lock and pyproject.toml
# We expect pyproject.toml to have an entry cointainer inside [dependency-groups]
RUN --mount=type=cache,target=/root/.cache \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync \
        --locked \
        --no-dev \
        --group container \
        --no-install-project

COPY . /src
WORKDIR /src

# Install package
RUN --mount=type=cache,target=/root/.cache \
    uv sync \
        --locked \
        --no-dev \
        --group container \
        --no-editable

# Move skeleton files to /app
RUN <<EOT
    mv /app_skeleton/* /app
    rm -Rf /app_skeleton
    mv scripts/create_site.py /app/scripts/create_site.py
EOT

# Compile translation files
RUN <<EOT
    /app/bin/python /compile_mo.py
EOT

FROM plone/server-acceptance:${PLONE_VERSION}

# Default matches backend/pyproject.toml [project].authors, which is the
# single source.
ARG MAINTAINER="Fred van Dijk <fred@plone.org>"

LABEL maintainer="${MAINTAINER}" \
      org.label-schema.name="playcluster-demo-acceptance" \
      org.label-schema.description="playcluster-demo backend acceptance image." \
      org.label-schema.vendor="${MAINTAINER}"

ENV CONFIGURE_PACKAGES="plone.restapi,plone.volto,plone.volto.cors,playclusterdemo"
ENV APPLY_PROFILES="playclusterdemo:default"

# Copy /app from builder
COPY --from=builder /app /app

RUN <<EOT
    ln -s /data /app/var
EOT
